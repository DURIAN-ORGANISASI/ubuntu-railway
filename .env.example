# Local reference only. Never commit real secrets.
TERMINAL_USER=change-this-user
TERMINAL_PASSWORD=replace-with-a-random-password-at-least-16-chars
TZ=Asia/Jakarta
HERMES_HOME=/opt/data
HERMES_AUTOSTART=true
# Railway sets PORT automatically; do not set it manually in Railway.
# Configure model/provider and messaging tokens with `hermes setup` and `hermes gateway setup`.
# For persistent Hermes config/history, mount a Railway Volume at /opt/data.
